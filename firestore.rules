rules_version = '2';



service cloud.firestore {

  match /databases/{database}/documents {

    match /statistics_events/{eventId} {
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.type == 'rewarded_ad'
        && (!('isCompensation' in request.resource.data)
          || request.resource.data.isCompensation is bool)
        && (!('compensationReason' in request.resource.data)
          || request.resource.data.compensationReason is string)
        && (!('outcome' in request.resource.data)
          || request.resource.data.outcome in [
            'completed', 'compensation', 'cancelled', 'failed',
            'shown', 'impression', 'clicked'
          ])
        && (!('placement' in request.resource.data)
          || request.resource.data.placement in [
            'reward_tokens', 'yes_no_unlock'
          ])
        && (!('reason' in request.resource.data)
          || request.resource.data.reason is string);
      allow read: if isAdmin();
    }

    match /app_presence/{userId} {
      // Emergency quota guard: older app versions wrote every 30 seconds.
      allow create, update: if false;
      allow read: if isAdmin();
    }

    match /app_activity_hours/{activityId} {
      // Disabled until presence tracking is moved off the Spark write quota.
      allow create, update: if false;
      allow read: if isAdmin();
    }

    function isSignedIn() {

      return request.auth != null;

    }



    function isOwner(userId) {

      return isSignedIn() && request.auth.uid == userId;

    }



    function isEmailVerified() {

      return isSignedIn() && request.auth.token.email_verified == true;

    }



    function isAdmin() {

      return isSignedIn()

        && request.auth.uid in [
          'l2vjDZXUbcOifjumq1q7HTubFxu2',
          'o0AyRibzJFfNb6BNYxUweM4RqAs2',
          'LmcMFwbp3eaLRrFRD2IURLW3reg1',
          'PcyiSwnAIWhkwlpsJ88fHYMFGJW2',
        ];

    }



    function protectedUserFieldsUnchanged() {

      return request.resource.data.get('uid', request.auth.uid)
          == resource.data.get('uid', request.auth.uid)

        && request.resource.data.get('email', '') == resource.data.get('email', '')

        && (!('createdAt' in resource.data)

          || request.resource.data.createdAt == resource.data.createdAt)

        && (!('referralCode' in resource.data)

          || request.resource.data.referralCode == resource.data.referralCode)

        && (!('referredBy' in resource.data)

          || request.resource.data.referredBy == resource.data.referredBy);

    }



    function istanbulDayIndex(ts) {
      // Türkiye sabit UTC+3 — takvim günü indeksi
      return int((ts.toMillis() + 10800000) / 86400000);
    }

    function rewardPeriodElapsed() {
      let last = resource.data.get('lastRewardAt', null);
      return last == null
        || istanbulDayIndex(request.time) != istanbulDayIndex(last);
    }

    function validRewardedAdGrant() {
      let oldTokens = resource.data.get('tokens', 0);
      let newTokens = request.resource.data.get('tokens', 0);
      let oldAds = resource.data.get('rewardedAdsToday', 0);
      let newAds = request.resource.data.get('rewardedAdsToday', 0);
      return newTokens == oldTokens + 25
        && newAds <= 6
        && (
          newAds == oldAds + 1
          || (rewardPeriodElapsed() && newAds == 1 && oldAds >= 1)
        );
    }

    function validTokenEconomyUpdate() {

      let oldTokens = resource.data.get('tokens', 0);

      let newTokens = request.resource.data.get('tokens', 0);

      return request.resource.data.get('specialFortuneRights', 0)
          == resource.data.get('specialFortuneRights', 0)
        && (newTokens == oldTokens

        || (newTokens < oldTokens && newTokens >= 0)

        || validRewardedAdGrant());

    }



    function validReferralSelfRewardUpdate() {

      let oldClaimed = resource.data.get('referralRewardClaimed', false);

      let newClaimed = request.resource.data.get('referralRewardClaimed', false);

      let referredBy = resource.data.get('referredBy', '');

      return request.resource.data.get('specialFortuneRights', 0)
          == resource.data.get('specialFortuneRights', 0)
        && !oldClaimed

        && newClaimed == true

        && referredBy is string

        && referredBy.size() > 0

        && request.resource.data.get('tokens', 0) == resource.data.get('tokens', 0) + 50;

    }



    function validInviterReferralClaimUpdate() {

      let oldTokens = resource.data.get('tokens', 0);

      let newTokens = request.resource.data.get('tokens', 0);

      let delta = newTokens - oldTokens;

      return delta == 50
        && request.resource.data.get('specialFortuneRights', 0)
          == resource.data.get('specialFortuneRights', 0);

    }



    function validReferralCodeSetUpdate() {

      return request.resource.data.get('specialFortuneRights', 0)
          == resource.data.get('specialFortuneRights', 0)
        && !('referralCode' in resource.data)

        && request.resource.data.referralCode is string

        && request.resource.data.referralCode.size() >= 6

        && request.resource.data.get('tokens', 0) == resource.data.get('tokens', 0);

    }



    match /referral_codes/{code} {

      allow read: if isSignedIn();

      allow create: if isSignedIn()

        && request.resource.data.uid == request.auth.uid

        && request.resource.data.code == code;

    }



    match /users/{userId} {

      // Başlangıç jetonu — token_config.dart `initialUserTokens` ile senkron (50).
      function allowedCreateTokenBalance() {
        return ('tokens' in request.resource.data)
          && request.resource.data.tokens is number
          && request.resource.data.tokens == 0;
      }

      function allowedCreateSpecialFortuneRights() {
        return request.resource.data.get('specialFortuneRights', 0) == 0;
      }

      function validReferredByOnCreate() {
        return !('referredBy' in request.resource.data)
          || (request.resource.data.referredBy is string
              && request.resource.data.referredBy.size() > 0
              && request.resource.data.referredBy != userId);
      }

      function validUserCreate() {
        return request.resource.data.uid == userId
          && request.resource.data.email is string
          && request.resource.data.email.size() >= 3
          && allowedCreateTokenBalance()
          && allowedCreateSpecialFortuneRights()
          && validReferredByOnCreate();
      }

      function validProfileOnlyUpdate() {
        return request.resource.data.get('tokens', 0) == resource.data.get('tokens', 0)
          && request.resource.data.get('specialFortuneRights', 0)
            == resource.data.get('specialFortuneRights', 0)
          && request.resource.data.get('rewardedAdsToday', 0)
            == resource.data.get('rewardedAdsToday', 0)
          && request.resource.data.get('referralRewardClaimed', false)
            == resource.data.get('referralRewardClaimed', false);
      }

      function validMissingTokensBackfill() {
        return (!('tokens' in resource.data) || resource.data.tokens == null)
          && allowedCreateTokenBalance()
          && request.resource.data.get('specialFortuneRights', 0)
            == resource.data.get('specialFortuneRights', 0)
          && protectedUserFieldsUnchanged();
      }

      function validSpecialFortuneRightUse() {
        let oldRights = resource.data.get('specialFortuneRights', 0);
        let newRights = request.resource.data.get('specialFortuneRights', 0);
        return oldRights >= 1
          && newRights == oldRights - 1
          && request.resource.data.get('tokens', 0) == resource.data.get('tokens', 0);
      }

      allow read: if isAdmin() || isOwner(userId);

      allow create: if isOwner(userId) && validUserCreate();

      allow update: if isOwner(userId)

        && protectedUserFieldsUnchanged()

        && (validProfileOnlyUpdate()

          || validMissingTokensBackfill()

          || validSpecialFortuneRightUse()

          || validTokenEconomyUpdate()

          || validReferralSelfRewardUpdate()

          || validInviterReferralClaimUpdate()

          || validReferralCodeSetUpdate());

      allow delete: if isOwner(userId);



      match /referral_credits/{creditId} {

        allow read: if isOwner(userId);

        allow create: if isSignedIn()

          && creditId == request.auth.uid

          && request.resource.data.fromUid == request.auth.uid

          && request.resource.data.amount == 50

          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.referredBy == userId;

        allow update, delete: if isOwner(userId);

      }

      match /daily_angel_cards/{dateKey} {
        allow read: if isOwner(userId);
        allow create, update, delete: if false;
      }

    }



    match /fortune_requests/{requestId} {

      allow read: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);



      allow create: if isEmailVerified()

        && request.resource.data.userId == request.auth.uid

        && request.resource.data.status == 'pending';



      allow update: if isSignedIn()

        && resource.data.userId == request.auth.uid

        && request.resource.data.userId == resource.data.userId;



      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;

    }



    match /couple_compatibility_requests/{requestId} {

      allow read: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);



      allow create: if isEmailVerified()

        && request.resource.data.userId == request.auth.uid

        && request.resource.data.status == 'pending';



      allow update: if isSignedIn()

        && resource.data.userId == request.auth.uid

        && request.resource.data.userId == resource.data.userId;



      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;

    }



    match /manual_fortune_requests/{requestId} {

      allow read: if isAdmin()

        || (isSignedIn() && resource.data.userId == request.auth.uid);



      allow create: if isEmailVerified()

        && request.resource.data.userId == request.auth.uid

        && request.resource.data.status == 'pending'

        && request.resource.data.paymentStatus == 'special_fortune_right'

        && request.resource.data.tokenCost == 0

        && request.resource.data.specialFortuneRightsUsed == 1

        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('specialFortuneRights', 0) >= 1

        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('specialFortuneRights', 0)
          == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('specialFortuneRights', 0) - 1

        && request.resource.data.readerId in ['serdar', 'hatice'];



      allow update: if isAdmin();



      allow delete: if isAdmin();

    }

    match /manual_reader_daily_quota/{dayKey} {

      allow read: if isSignedIn();

      allow create: if isEmailVerified()
        && (
          (request.resource.data.get('serdar', 0) == 1
            && request.resource.data.get('hatice', 0) == 0)
          || (request.resource.data.get('hatice', 0) == 1
            && request.resource.data.get('serdar', 0) == 0)
        );

      allow update: if isEmailVerified()
        && (
          (request.resource.data.serdar == resource.data.get('serdar', 0) + 1
            && request.resource.data.serdar <= 20
            && request.resource.data.hatice == resource.data.get('hatice', 0))
          || (request.resource.data.hatice == resource.data.get('hatice', 0) + 1
            && request.resource.data.hatice <= 20
            && request.resource.data.serdar == resource.data.get('serdar', 0))
        );

      allow delete: if false;

    }

    match /manual_reader_status/{docId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(
          [
            'serdar', 'hatice',
            'serdarVisible', 'haticeVisible',
            'updatedAt', 'updatedBy'
          ]
        )
        && (!('serdar' in request.resource.data)
          || request.resource.data.serdar in [
            'auto', 'molada', 'fal_bakiyor',
            'mesai_saati_disinda', 'gunluk_fal_limiti_doldu'
          ])
        && (!('hatice' in request.resource.data)
          || request.resource.data.hatice in [
            'auto', 'molada', 'fal_bakiyor',
            'mesai_saati_disinda', 'gunluk_fal_limiti_doldu'
          ])
        && (!('serdarVisible' in request.resource.data)
          || request.resource.data.serdarVisible is bool)
        && (!('haticeVisible' in request.resource.data)
          || request.resource.data.haticeVisible is bool);
      allow delete: if isAdmin();
    }

    match /play_purchases/{purchaseToken} {

      allow read: if isAdmin()

        || (isSignedIn() && resource.data.uid == request.auth.uid);

      allow create, update, delete: if false;

    }

    match /notification_schedules/{scheduleId} {

      allow read, write: if false;

    }

    match /daily_horoscopes/{dateId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /admin_broadcasts/{broadcastId} {
      allow read, write: if false;
    }

    match /admin_angel_cards/{docId} {
      allow read, write: if false;
    }

    match /admin_token_grants/{grantId} {
      allow read, write: if false;
    }

    match /problem_reports/{reportId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);

      allow create: if isEmailVerified()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.description.size() <= 2000
        && request.resource.data.userEmail is string
        && request.resource.data.displayName is string
        && request.resource.data.platform is string;

      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

  }

}
